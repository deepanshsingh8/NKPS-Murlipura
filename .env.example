# NK Public School, Murlipura — environment variables
#
# Local development:
#   cp .env.example .env.local   # then fill in real values
#   ln -sf ../../.env.local apps/website/.env.local
#   ln -sf ../../.env.local apps/cms/.env.local
#   ln -sf ../../.env.local apps/erp/.env.local
#
# Production: set these in each Vercel project's Settings → Environment
# Variables. The "app" column in DEPLOYMENT.md says which project needs which.
#
# NEVER commit .env.local — SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely.
#
# WHICH PROJECT NEEDS WHAT (Vercel)
#   all three  NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#              SUPABASE_SERVICE_ROLE_KEY, the three cross-app URLs,
#              TRUSTED_IP_HEADER
#   website +  NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_GA_ID,
#              NEXT_PUBLIC_GSC_VERIFICATION, ANTHROPIC_API_KEY,
#              RESEND_API_KEY, FROM_EMAIL, REPLY_TO_EMAIL,
#              ADMIN_NOTIFICATION_EMAIL
#   erp     +  RESEND_API_KEY, FROM_EMAIL, REPLY_TO_EMAIL,
#              EXOTEL_* (optional), SAFE_FETCH_ALLOWED_HOSTS (optional),
#              TEMP_PASSWORD_SECRET (optional)
#   cms        nothing beyond the shared set — it sends no mail and has no
#              public SEO surface. It DOES need SUPABASE_SERVICE_ROLE_KEY:
#              every CMS API route goes through verifyAdminOrEditor ->
#              createAdminClient, even though no CMS file names the variable.

# ── Supabase (required — all three apps) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cross-app URLs (required — all three apps) ───────────────────────────────
# Used by packages/shared/src/lib/cross-app.ts to build links between apps.
# Local defaults are http://localhost:3001 / :3002 / :3003 if unset.
NEXT_PUBLIC_WEBSITE_URL=https://www.nkpublicschool.org
NEXT_PUBLIC_CMS_URL=https://cms.nkpublicschool.org
NEXT_PUBLIC_ERP_URL=https://erp.nkpublicschool.org

# ── Public site SEO (website only) ───────────────────────────────────────────
# Canonical origin for metadata, sitemap.xml, robots.txt and the OG image.
# Must be the origin that does NOT redirect. Canonical is www, matching the
# nkpublicschool.com deployment; the apex 301s to it in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.nkpublicschool.org
# GA4 measurement ID (G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=
# Google Search Console meta-tag token (only if verifying by HTML tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Email — Resend (website + erp) ───────────────────────────────────────────
# Powers the public contact form and the ERP portal's account emails
# (welcome, password reset, registration approve/reject).
RESEND_API_KEY=
# Must be a domain verified in Resend, or delivery fails.
FROM_EMAIL=NK Public School <noreply@nkpublicschool.org>
REPLY_TO_EMAIL=nkpsem@gmail.com
# Inbox that receives new contact-form / registration notifications.
ADMIN_NOTIFICATION_EMAIL=nkpsem@gmail.com

# ── Temporary-password vault (erp only, optional) ────────────────────────────
# Encrypts the temporary passwords shown on /administration/users for accounts that
# haven't set their own yet. Leave blank and SUPABASE_SERVICE_ROLE_KEY is used
# to derive the key instead — set this only if you want the two to rotate
# independently. Changing either value makes already-stored temporary passwords
# unreadable; the admin simply issues new ones.
TEMP_PASSWORD_SECRET=

# ── AI assistant (website + erp, optional) ───────────────────────────────────
# Enables the home-page assistant and, in the ERP, "Ask the school", the in-app
# guide and report-card remark drafts. Unset = those features are off. The ERP
# features also need school_profile.ai_enabled = true in the database
# (scripts/_enable-ai-assistant.sql) — setting the key alone turns nothing on.
ANTHROPIC_API_KEY=

# ── WhatsApp channel for the parent assistant (erp only, optional) ───────────
# Meta Cloud API. Leave blank to disable. Not related to the Class Diary, which
# replaces the class WhatsApp groups inside the portal and needs no keys.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── App Lock / Face ID (erp + cms, optional) ─────────────────────────────────
# Passkeys are bound to this Relying Party ID forever, so set it once, before
# anyone enrols: the bare apex domain, no scheme. Origins are the app URLs.
# Must match Supabase → Authentication → Passkeys. Unset = browser defaults
# (fine for localhost).
NEXT_PUBLIC_WEBAUTHN_RP_ID=nkpublicschool.org
NEXT_PUBLIC_WEBAUTHN_RP_ORIGINS=https://erp.nkpublicschool.org,https://cms.nkpublicschool.org

# ── Telephony — Exotel (erp only, optional) ──────────────────────────────────
# Click-to-call from ERP. Leave blank to disable the feature.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLBACK_TOKEN=

# ── Hardening (optional) ─────────────────────────────────────────────────────
# Comma-separated extra hostnames the server-side fetch allowlist permits.
# ERP only — used when admit-card generation pulls remote images.
SAFE_FETCH_ALLOWED_HOSTS=
# Single-value proxy header trusted as the client IP for rate limiting.
# On Vercel use x-vercel-forwarded-for; behind Cloudflare use cf-connecting-ip.
TRUSTED_IP_HEADER=x-vercel-forwarded-for
