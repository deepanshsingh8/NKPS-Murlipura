{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_WEBSITE_URL",
    "NEXT_PUBLIC_CMS_URL",
    "NEXT_PUBLIC_ERP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_GA_ID",
    "NEXT_PUBLIC_GSC_VERIFICATION",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
    "ANTHROPIC_API_KEY",
    "GMAIL_USER",
    "GMAIL_APP_PASSWORD",
    "FROM_EMAIL",
    "REPLY_TO_EMAIL",
    "RESEND_API_KEY",
    "ADMIN_NOTIFICATION_EMAIL",
    "SAFE_FETCH_ALLOWED_HOSTS",
    "TRUSTED_IP_HEADER",
    "EXOTEL_SID",
    "EXOTEL_API_KEY",
    "EXOTEL_API_TOKEN",
    "EXOTEL_CALLER_ID",
    "EXOTEL_SUBDOMAIN",
    "EXOTEL_CALLBACK_TOKEN",
    "NEXT_PUBLIC_WEBAUTHN_RP_ID",
    "NEXT_PUBLIC_WEBAUTHN_RP_ORIGINS",
    "TEMP_PASSWORD_SECRET",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_VERIFY_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
